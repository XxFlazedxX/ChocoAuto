-- === Dragging logic ===
do
    local dragging = false
    local dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end

    dragBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)

    dragBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

-- === Targeting + Grapple logic ===
local targetPlayer = nil
local isEnabled = false
local fireRate = 0.10 -- seconds between shots

local function getPredictedPosition(hrp)
    local v = hrp.AssemblyLinearVelocity
    local pf
    if v.Y > 1 then
        pf = 0.33
    elseif math.abs(v.X) > 4 or math.abs(v.Z) > 7 then
        pf = 0.20
    else
        pf = 0.01
    end
    return hrp.Position + (v * pf)
end

local function findGrappleTool()
    -- prefers equipped tool, falls back to backpack
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    for _, c in ipairs({char, LocalPlayer:FindFirstChildOfClass("Backpack")}) do
        if c then
            for _, item in ipairs(c:GetChildren()) do
                if item:IsA("Tool") and (item:FindFirstChildWhichIsA("RemoteEvent", true) or item:FindFirstChild("RemoteEvent")) then
                    return item, (item:FindFirstChildWhichIsA("RemoteEvent", true) or item:FindFirstChild("RemoteEvent"))
                end
            end
        end
    end
    return nil, nil
end

local function findPlayerByName(partial)
    local s = string.lower(partial or "")
    if s == "" then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(plr.Name), s, 1, true) or string.find(string.lower(plr.DisplayName), s, 1, true) then
            return plr
        end
    end
    return nil
end

local function fireGrappleOnce()
    if not targetPlayer or not targetPlayer.Character then
        warn("No valid target.")
        return
    end
    local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        warn("Target has no HRP.")
        return
    end
    local tool, remote = findGrappleTool()
    if not remote then
        warn("No grapple tool/remote found or not equipped.")
        return
    end
    local pos = getPredictedPosition(hrp)
    -- Some tools expect a Vector3, others a CFrame or table; try Vector3 first
    local ok = pcall(function()
        remote:FireServer(pos)
    end)
    if not ok then
        -- fallback: try CFrame if their remote expects it
        pcall(function()
            remote:FireServer(CFrame.new(pos))
        end)
    end
end

local running = false
local function grappleLoop()
    if running then return end
    running = true
    while isEnabled do
        fireGrappleOnce()
        task.wait(fireRate)
    end
    running = false
end

local function setEnabled(state)
    if isEnabled == state then return end
    isEnabled = state
    toggleBtn.Text = isEnabled and "Grapple Script: ON" or "Grapple Script: OFF"
    if isEnabled then
        task.spawn(grappleLoop)
    end
end

-- === Wiring ===
toggleBtn.MouseButton1Click:Connect(function()
    local nameTxt = (playerNameBox.Text or ""):gsub("^%s*(.-)%s*$", "%1")
    if nameTxt == "" then
        warn("Enter a player name first.")
        return
    end
    targetPlayer = findPlayerByName(nameTxt)
    if not targetPlayer then
        warn("Player not found.")
        setEnabled(false)
        return
    end
    setEnabled(not isEnabled)
end)

fireOnceBtn.MouseButton1Click:Connect(function()
    local nameTxt = (playerNameBox.Text or ""):gsub("^%s*(.-)%s*$", "%1")
    if nameTxt ~= "" then
        targetPlayer = findPlayerByName(nameTxt) or targetPlayer
    end
    fireGrappleOnce()
end)

-- optional: auto-reacquire target if they respawn
Players.PlayerRemoving:Connect(function(plr)
    if plr == targetPlayer then
        targetPlayer = nil
        setEnabled(false)
    end
end)

-- optional: press "1" to auto-equip after respawn (if your grapple is on slot 1)
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    pcall(function()
        game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.One, false, game)
        game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.One, false, game)
    end)
end)
